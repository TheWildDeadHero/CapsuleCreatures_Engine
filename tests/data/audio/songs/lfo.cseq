# Modulation: depth, speed, delay, types 0-2; bend and its range; transpose; fine tune.
TRACK
PROGRAM 0
VOLUME 100
MOD_DEPTH 40
LFO_SPEED 30
NOTE 48 c4 v100
WAIT 48
MOD_TYPE 1
LFO_DELAY 10
NOTE 48 e4 v100
WAIT 48
MOD_TYPE 2
LFO_SPEED 0
LFO_SPEED 60
NOTE 48 g4 v100
WAIT 48
MOD_TYPE 0
MOD_DEPTH 0
BEND_RANGE 12
BEND 96
NOTE 24 c4 v100
WAIT 12
BEND 20
WAIT 12
BEND 64
TRANSPOSE -5
NOTE 12 c4
WAIT 12
TRANSPOSE 7
FINE_TUNE 90
NOTE 12 c4
WAIT 12
FINE_TUNE 10
MOD_DEPTH 127
LFO_SPEED 255
NOTE 24 c4
WAIT 24
END
TRACK
PROGRAM 11
VOLUME 100
MOD_DEPTH 60
LFO_SPEED 20
NOTE 48 c4 v100
WAIT 48
MOD_TYPE 1
NOTE 48 c4 v100
WAIT 48
MOD_TYPE 2
NOTE 48 c4 v100
WAIT 48
BEND_RANGE 2
BEND 127
MOD_TYPE 0
NOTE 24 a4 v100
WAIT 24
END
