{
  "schema": "capsule.vm-ext/1",
  "vm": "battle",
  "name": "alias_tests",
  "notes": "tests/battle_vm_alias_tests.cpp: one alias per generic step of the battle script machine (simple test content), run against hand-written natives of the same layouts.",
  "owner": "VX",
  "tier": 0,
  "space": {"first": 0, "last": 23},
  "refs": {"v0": {"kind": "variable", "id": 0}, "v3": {"kind": "variable", "id": 3}},
  "dispatch": {"form": "fragment", "symbol": "kAliasTable", "count": 24, "resolver": "resolve_ref",
               "native_prefix": "native_"},
  "ops": [
    {"id": 0, "name": "end", "kind": "alias", "expands": [{"op": "end", "args": {}}]},
    {"id": 1, "name": "goto", "kind": "alias", "operands": [{"name": "to", "type": "code"}],
     "expands": [{"op": "jump", "args": {"target": "to"}}]},
    {"id": 2, "name": "call", "kind": "alias", "operands": [{"name": "to", "type": "code"}],
     "expands": [{"op": "call", "args": {"target": "to"}}]},
    {"id": 3, "name": "return", "kind": "alias", "expands": [{"op": "return", "args": {}}]},
    {"id": 4, "name": "jumpifbyte", "kind": "alias",
     "operands": [{"name": "cmp", "type": "u8"}, {"name": "var", "type": "ref"}, {"name": "value", "type": "u8"},
                  {"name": "to", "type": "code"}],
     "expands": [{"op": "jump_if", "width": 1, "args": {"compare": "cmp", "ref": "var", "value": "value", "target": "to"}}]},
    {"id": 5, "name": "jumpifhalfword", "kind": "alias",
     "operands": [{"name": "cmp", "type": "u8"}, {"name": "var", "type": "ref"}, {"name": "value", "type": "u16"},
                  {"name": "to", "type": "code"}],
     "expands": [{"op": "jump_if", "width": 2, "args": {"compare": "cmp", "ref": "var", "value": "value", "target": "to"}}]},
    {"id": 6, "name": "jumpifword", "kind": "alias",
     "operands": [{"name": "cmp", "type": "u8"}, {"name": "var", "type": "ref"}, {"name": "value", "type": "u32"},
                  {"name": "to", "type": "code"}],
     "expands": [{"op": "jump_if", "width": 4, "args": {"compare": "cmp", "ref": "var", "value": "value", "target": "to"}}]},
    {"id": 7, "name": "setbyte", "kind": "alias", "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "u8"}],
     "expands": [{"op": "modify", "alu": "set", "width": 1, "args": {"ref": "var", "value": "value"}}]},
    {"id": 8, "name": "addbyte", "kind": "alias", "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "u8"}],
     "expands": [{"op": "modify", "alu": "add", "width": 1, "args": {"ref": "var", "value": "value"}}]},
    {"id": 9, "name": "subbyte", "kind": "alias", "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "u8"}],
     "expands": [{"op": "modify", "alu": "sub", "width": 1, "args": {"ref": "var", "value": "value"}}]},
    {"id": 10, "name": "orhalfword", "kind": "alias", "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "u16"}],
     "expands": [{"op": "modify", "alu": "or", "width": 2, "args": {"ref": "var", "value": "value"}}]},
    {"id": 11, "name": "bicword", "kind": "alias", "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "u32"}],
     "expands": [{"op": "modify", "alu": "bic", "width": 4, "args": {"ref": "var", "value": "value"}}]},
    {"id": 12, "name": "copyarray", "kind": "alias",
     "operands": [{"name": "dest", "type": "ref"}, {"name": "src", "type": "ref"}, {"name": "size", "type": "u8"}],
     "expands": [{"op": "copy", "args": {"dest": "dest", "src": "src", "size": "size"}}]},
    {"id": 13, "name": "jumpifarrayequal", "kind": "alias",
     "operands": [{"name": "a", "type": "ref"}, {"name": "b", "type": "ref"}, {"name": "size", "type": "u8"},
                  {"name": "to", "type": "code"}],
     "expands": [{"op": "jump_if_bytes", "when": "equal", "args": {"a": "a", "b": "b", "size": "size", "target": "to"}}]},
    {"id": 14, "name": "jumpifarraynotequal", "kind": "alias",
     "operands": [{"name": "a", "type": "ref"}, {"name": "b", "type": "ref"}, {"name": "size", "type": "u8"},
                  {"name": "to", "type": "code"}],
     "expands": [{"op": "jump_if_bytes", "when": "not_equal", "args": {"a": "a", "b": "b", "size": "size", "target": "to"}}]},
    {"id": 15, "name": "pause", "kind": "alias", "waits": true, "operands": [{"name": "frames", "type": "u16"}],
     "expands": [{"op": "pause", "args": {"frames": "frames"}}]},
    {"id": 16, "name": "waitflag", "kind": "alias", "waits": true, "operands": [{"name": "frames", "type": "u16"}],
     "expands": [{"op": "pause_if_set", "args": {"flag": {"ref": "v3"}, "frames": "frames"}}]},
    {"id": 17, "name": "waituntil", "kind": "alias", "waits": true,
     "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "u8"}],
     "expands": [{"op": "wait_until", "width": 1, "args": {"compare": {"const": "equal"}, "ref": "var", "value": "value"}}]},
    {"id": 18, "name": "hold", "kind": "alias", "expands": [{"op": "hold", "args": {}}]},
    {"id": 19, "name": "yieldnop", "kind": "alias", "expands": [{"op": "yield", "args": {}}]},
    {"id": 20, "name": "choose", "kind": "alias",
     "operands": [{"name": "even", "type": "code"}, {"name": "odd", "type": "code"}],
     "expands": [{"op": "jump_if", "width": 1, "args": {"compare": {"const": "common_bits"}, "ref": {"ref": "v0"},
                                                       "value": {"const": 1}, "target": "odd"}},
                 {"op": "jump", "args": {"target": "even"}}]},
    {"id": 21, "name": "signedadd", "kind": "alias", "operands": [{"name": "var", "type": "ref"}, {"name": "value", "type": "s8"}],
     "expands": [{"op": "modify", "alu": "add", "width": 2, "args": {"ref": "var", "value": "value"}}]},
    {"id": 22, "name": "nop", "kind": "alias", "expands": [{"op": "nop", "args": {}}]},
    {"id": 23, "name": "poke", "kind": "native", "symbol": "native_poke",
     "operands": [{"name": "value", "type": "u8"}],
     "reason": "Test-only native: writes the context's poke field, which no reference names."}
  ]
}
