// Test fixture for tests/script_tests.cpp (invented content).

flag f_perm;
flag f_daily : daily;
flag f_area : area;
flag f_map : map;
var v8 : u8;
var v16 : u16 0..1000;
var vmin : u8 map 5..10;
var answer : u8 map;
var out : u32;
const LIMIT = 7;
native add(a, b) -> value;
native slow(frames) waits;

// Loops, conditions, switch, calls and saturation.
script flow {
    var(v8) = 0;
    while var(v8) < LIMIT { var(v8) += 1; }
    if var(v8) == 7 && !flag(f_perm) { set flag(f_perm); }
    switch var(v8) {
        case 1, 2 { var(v16) = 1; }
        case 7 { var(v16) = 70; }
        default { var(v16) = 999; }
    }
    call sub;
    var(v16) += 2000;
    when game(other) { var(v16) = 5; }
    when not game(other) { set flag(f_daily); }
}

script sub { var(out) = 123456; return; }

// Messages and menus.
script talk {
    msg "Hello";
    wait_button;
    yesno -> var(answer);
    if var(answer) == yes { msgbox text:"Test line"; }
    choice ["One", "Two", "Three"] cancel 2 -> var(answer);
    close_msg;
}

script natives {
    native add(2, var(v8)) -> var(out);
    native slow(3);
    delay 2;
    var(out) += 1;
}

script table { call var(v8) of [t0, t1]; }
script t0 { var(out) = 10; }
script t1 { var(out) = 11; }

// Never waits: the VM yields after kOpsPerFrame instructions.
script spin {
top:
    var(v16) += 1;
    goto top;
}

script deep1 { call deep2; }
script deep2 { call deep3; }
script deep3 { var(out) = 3; }

script load_field { set flag(f_map); }
script fire { var(answer) = 0; clear flag(f_map); }

map_scripts field {
    on_load -> load_field;
    on_frame flag(f_map) -> fire;
}

script banks { set flag(f_area); var(vmin) = 7; }

// Map object commands (B-21) against the test world (tests/script_tests.cpp).
const GUARD = 3;
script objects {
    face self player;
    move self left 2;
    move player up;
    face player self;
    face GUARD right;
    hide GUARD;
    show var(v8);
    move 9 down 0;
}

// A walk by the field's movement rules (tests/script_tests.cpp test_checked_move()).
var walk_ok : u8 0..1;
script checked_walk { move player up 2 checked -> var(walk_ok); }

// RPG Maker XP-style commands against the test world.
var key : u8 0..10;
var num : u16;
script eventing {
    route self skip { up 2; wait 3; }
    route 2 repeat { left; }
    wait_moves;
    set self(B);
    if self(B) { var(out) = pos_x(self); }
    var(v16) = pos_y(player);
    var(v16) += steps;
    var(out) *= 3;
    var(v8) = 7;
    var(v8) %= 4;
    msg_pos top;
    input_number 3 -> var(num);
    wait_key -> var(key);
    place player 4 5 up;
    scroll right 2;
    tint 31 0 0 8 30;
    flash 0 0 31 10;
    shake 2 20;
    timer start 90;
    timer stop;
    encounters off;
    vehicle swim;
    vehicle 0;
    warp field 1 2 down box;
    var(answer) = facing(self);
}

// Field placeholders: a name slot, a variable, a term and a
// party record field; a prompt and a page break.
script greet {
    msgbox "Hi {hero}! {count} in {town}.{prompt}{page}{lead} {@town:many}";
    close_msg;
}

// Party records: engine and custom roles of the game's layout
// (the manifest's battle) by name, by role ID and by constant.
const SECOND = 1;
const RIBBONS_ID = 129;
var met : u8 0..127;
script records {
    role_set(0, met_level, 42);
    role_get(0, met_level) -> var(met);
    role_set(SECOND, ribbons, 31, 1);
    role_get(SECOND, ribbons, 31) -> var(v8);
    role_get(2, level) -> var(v16);
    role_set(var(v8), gender, 3);
    role_set(0, RIBBONS_ID, 0, 1);
    role_set(0, 129, 1, var(v8));
    role_get(0, nickname, 7) -> var(answer);
}

// The bag: give / take / count by item id (this fixture's battle has no items: the port stub counts),
// the bag menu and the game's time of day.
var bag_ok : u8;
script bag {
    give_item(3, 2) -> var(bag_ok);
    count_item(3) -> var(v8);
    take_item(3) -> var(answer);
    give_item(var(v8), 1);
    time_of_day -> var(v16);
    open_bag -> var(met);
}

// The storage boxes through the boxes port (tests/script_tests.cpp test_boxes: a stub port)
script boxes {
    deposit_box(1) -> var(bag_ok);
    count_boxed -> var(v8);
    withdraw_box(var(v8)) -> var(answer);
    deposit_box(9);
    open_boxes -> var(met);
}

// A party member's transformation through the growth port (tests/script_tests.cpp test_transform: a stub
// port: member 1 changes, member 0 is stopped)
script grow {
    transform(1) -> var(v8);
    transform(0) -> var(answer);
}

// The combination statements through the combine port (tests/script_tests.cpp test_combine: a stub port that
// answers the queries from their kind, method and members, combines in run and backs out in open)
script mix {
    combine preview pair (0, 1) -> var(v8);
    combine status pair (1, 0) -> var(v16);
    combine fee pair (0, 1) -> var(bag_ok);
    combine run pair (1, var(v8)) -> var(answer);
    combine open pair -> var(out);
}

// F1: the timed field effects of the battle manifest's structure (tests/data/battle_stats3: ward by steps, refused
// while it runs; glow by minutes, added up; lure by steps, started over); tests/script_tests.cpp test_field_effects
script fx {
    field_effect start ward 3 -> var(bag_ok);
    field_effect start ward 9 -> var(answer);
    field_effect active ward -> var(v8);
    field_effect remaining ward -> var(v16);
    field_effect start glow 5;
}

// Darkness, the world's flight points, the escape point (test_f2).
script f2 {
    darkness 2;
    flight record home;
    flight visit town_gate wipe_h;
    flight menu -> var(out);
    escape -> var(answer);
}
script field_action_escape { escape fade -> var(answer); }

// The statements imported event scripts need (tests/script_tests.cpp test_port_statements()).
movement port_walk { up; }
mart port_mart { 1, 2 }
script port_other { var(out) = 7; return; }
script ports {
    lock all;
    msg "Hi" nowait;
    wait_msg;
    route 2 port_walk nowait;
    wait_moves last;
    remove 2;
    visible 2 off;
    set_template 2 pos 3 4;
    door open 1 2;
    door wait;
    weather set 3;
    fade to_black;
    set_metatile 1 2 5 1;
    respawn 4;
    set_warp dynamic town 1 2;
    sound se 9;
    wait_sound se;
    mart port_mart;
    wait_state;
    release all;
    call port_other loose;
    goto port_loop;
}
// a loose call that recurses: past the stack (stack_depth 4) it goes on as a jump
script port_loop {
    var(v8) += 1;
    if var(v8) < 30 { call port_loop loose; }
}
script port_resume { var(answer) = 5; }
script port_warp_into { var(answer) += 1; }
map_scripts town {
    on_resume -> port_resume;
    on_warp_into var(v8) == 0 -> port_warp_into;
    on_warp_into var(v8) == 0 -> port_other;
}

// D-36 package 2 C1: the encounter record and battles through the battle port (tests/script_tests.cpp
// test_encounter: a stub port that records each request and runs for kBattlePolls frames)
flag f_beaten_a;
flag f_beaten_b;
script fight {
    encounter clear;
    encounter set a 12 self beaten flag(f_beaten_a) intro "Hey!" defeat "Lost..." after fight_after
        then fight_start pair mode 1;
    var(out) = 99;
}
script fight_start {
    encounter get beaten -> var(v8);
    if var(v8) != 0 { encounter continue; }
    encounter set b 13 3 beaten flag(f_beaten_b) intro "Me too!";
    encounter select b;
    encounter text intro;
    encounter get object -> var(v16);
    encounter select a;
    encounter text intro;
    encounter music;
    face player encounter;
    battle party -> var(answer);
    encounter mark;
    encounter get sides -> var(bag_ok);
    encounter get mode -> var(walk_ok);
    encounter after;
    var(out) = 1;
}
script fight_after { var(out) = 7; }
// C1b: a spotter group (the field's group in the test world: spotter_one, spotter_none, spotter_two): loaded,
// walked up one by one with their intros, one battle against both, then their after-scripts in turn
script spot_group {
    encounter load;
    encounter get sides -> var(v8);
    goto spot_approach;
}
script spot_approach {
    encounter approach;
    encounter text intro;
    encounter next -> var(answer);
    if var(answer) == 1 { goto spot_approach; }
    battle party;
    goto spot_after;
}
script spot_after {
    encounter after;
    encounter next -> var(answer);
    if var(answer) == 1 { goto spot_after; }
}
script spotter_one {
    encounter set current 21 self beaten flag(f_beaten_a) intro "One!" then fight_start mode 2;
    var(out) = 55;
}
script spotter_none { var(bag_ok) = 1; }
script spotter_two {
    var(v16) = 4;
    encounter set a 22 self intro "Two!" then fight_start;
}
// C1b: a new encounter on side A leaves no side of the group before
script spot_single {
    encounter set a 30 self;
    battle party;
}
// C2: props and an object's draw order
script props {
    var(v8) = 9;
    prop place 4 sprite:PROP_TEST 12 var(v8) 3 left;
    prop face 4 up;
    prop remove 4;
    order player 83;
    order self reset;
}
// C3: positioned menus of a list asset
script menus {
    menu list:MENU_COLORS at 17 6 default 1 delay 2 cancel 127 fadewait -> var(answer);
    menu list:MENU_COLORS columns 3 cancel 127 noback -> var(v8);
    menu list:MENU_COLORS rows 2 style text_box:MENU_STYLE -> var(v16);
}
// C4: name slots from every source
script names {
    name str:1 = text:MENU_BLUE;
    var(v8) = 1;
    name str:2 = list:STD_WORDS var(v8);
    name str:3 = number 123456789;
    name str:4 = trophy 7 count var(v8);
    name str:5 = "A long inline name";
}
// C5: counter boxes
script counters {
    var(v16) = 250;
    counter show gold at 20 1;
    var(v16) = 75;
    counter update gold;
    counter hide gold;
    counter show tokens at 0 0;
}
script stats {
    var(v16) = 995;
    stat add steps 10;
    stat add visits;
    var(v8) = 3;
    stat add visits var(v8);
}
script battle_setup {
    battle prepare 4 5;
    battle scripted 2;
    battle outcome -> var(v8);
    battle rematch due -> var(v16);
    battle rematch ready -> var(answer);
}
script scenes {
    map redraw;
    map layout 2;
    var(v8) = 7;
    animation arg 1 var(v8);
    animation start 5;
    animation wait 5;
    camera detach;
    camera shake 2 3 4 5;
    camera attach;
    darkness 1 fade;
}
script pictures_screens {
    map banner;
    picture show 25 1 2;
    picture hide;
    screen 0;
    screen 3;
}
script party_ops {
    party heal;
    party stash;
    party restore;
    party count -> var(answer);
    party count hatched -> var(v8);
}
script party_find {
    var(v8) = 7;
    party find move 34 -> var(answer) species var(v8);
    var(v16) = var(answer);
    party find move 33 -> var(answer) species var(v8);
}
script party_give {
    party give 4 5 item 7 -> var(answer);
    var(v16) = 6;
    party give var(v16) 9 -> var(v8);
    party give egg 3 -> var(v16);
}
var m_moves : u8;
var m_type : u8;
var m_species : u16;
script clock_ops {
    clock hour -> var(answer);
    clock weekday -> var(v8);
    clock season -> var(v16);
    clock days -> var(m_moves);
    clock wait 5 -> var(m_type);
    clock reset;
}
script plot_ops {
    plot 3 plant 2;
    plot 3 water;
    plot var(v8) pick -> var(answer);
    plot 3 stage -> var(v16);
    plot 3 crop -> var(m_moves);
    plot 3 yield -> var(m_type);
    plot 3 clear;
}
script party_members {
    party lead -> var(answer);
    party count alive -> var(v8);
    party count alive except 1 -> var(v16);
    member 2 moves -> var(m_moves);
    party has type 9 -> var(m_type);
    member var(answer) species -> var(m_species);
}
script item_queries {
    item_room(3, 5) -> var(v8);
    item_room(3, 200) -> var(answer);
    item_pocket(9) -> var(v16);
}
script lone_battle {
    battle unowned 25 5 -> var(answer);
    battle scripted 3;
}
