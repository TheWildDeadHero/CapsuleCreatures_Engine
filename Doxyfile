# Doxygen configuration for the CapsuleCreatures engine (Doxygen 1.9.8 or later).
#
# Build the HTML reference with the CMake target `docs` (or `doxygen` in this
# folder); output goes to build/docs/html/index.html.
#
# Project rule: every file, type, function, enum value, member and macro in
# include/, src/, apps/ and tools/ carries a Doxygen comment, and every
# documented function documents its parameters and return value. CI runs
# Doxygen with warnings as errors, so anything undocumented fails the build.

PROJECT_NAME           = "CapsuleCreatures Engine"
PROJECT_BRIEF          = "Monster-capture RPG engine for GBA, desktop and Dreamcast"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

# What is extracted (and therefore checked).
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO

# Warnings: the documentation rule.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

# Sources. tests/ is not part of the reference.
INPUT                  = include src apps tools README.md
FILE_PATTERNS          = *.h *.cpp *.py
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
USE_MDFILE_AS_MAINPAGE = README.md

# The POD size-lock macro is a list of static_asserts, not a declaration.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "CAPSULE_POD(T,bytes)="

# Output.
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
