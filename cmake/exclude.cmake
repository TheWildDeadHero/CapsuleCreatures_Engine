# D-36 package 3 step 3B (docs/USAGE.md "Exclusion manifest"): compiling excluded engine modules out.
#
# A parent build sets CAPSULE_EXCLUDE to its game's capsule.exclude/1 manifest before add_subdirectory() of the
# engine (one game per build folder). The engine library then leaves out the excluded modules' sources, and the
# generated header capsule/exclude_config.h tells the always-compiled code that reaches them (its cut points) which
# are out, as `inline constexpr bool` constants used with `if constexpr`. Without a manifest every constant is false
# and the library is the whole engine.

## The modules a game can exclude (tools/usage_exclude.py EXCLUDABLE_MODULES; tests/test_usage_exclude.py compares).
set(CAPSULE_EXCLUDABLE_MODULES combine growth monster seq storage)
set(CAPSULE_EXCLUDE "" CACHE FILEPATH
    "Engine: a capsule.exclude/1 manifest whose modules the library leaves out (one game per build folder)")

# Reads the manifest's modules.
# @param path  the manifest
# @param out   the variable to set (the excluded modules)
function(capsule_exclude_read path out)
   if(NOT EXISTS ${path})
      message(FATAL_ERROR "CAPSULE_EXCLUDE: ${path} does not exist")
   endif()
   file(READ ${path} json)
   string(JSON schema ERROR_VARIABLE err GET "${json}" schema)
   if(err OR NOT schema STREQUAL "capsule.exclude/1")
      message(FATAL_ERROR "CAPSULE_EXCLUDE: ${path} is not a capsule.exclude/1 manifest")
   endif()
   set(modules)
   string(JSON count ERROR_VARIABLE err LENGTH "${json}" modules)
   if(NOT err AND count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(i RANGE ${last})
         string(JSON name GET "${json}" modules ${i} name)
         if(name IN_LIST CAPSULE_EXCLUDABLE_MODULES)
            list(APPEND modules ${name})
         elseif(EXISTS ${CAPSULE_ROOT}/src/${name})
            message(FATAL_ERROR "CAPSULE_EXCLUDE: module ${name} cannot be excluded "
                                "(excludable: ${CAPSULE_EXCLUDABLE_MODULES})")
         else()
            message(WARNING "CAPSULE_EXCLUDE: this engine has no module ${name} (a stale exclusion)")
         endif()
      endforeach()
   endif()
   list(REMOVE_DUPLICATES modules)
   set(${out} ${modules} PARENT_SCOPE)
endfunction()

# Writes capsule/exclude_config.h (only when its text changes, so the sources that include it rebuild only then).
# @param dir      the include folder it goes in
# @param modules  the excluded modules
function(capsule_exclude_header dir modules)
   set(text "// Generated by the engine's cmake/exclude.cmake from CAPSULE_EXCLUDE: do not edit.\n")
   string(APPEND text "#pragma once\n\n")
   string(APPEND text "/// D-36 package 3: the engine modules this build leaves out (the cut points read these).\n")
   string(APPEND text "namespace capsule::exclude\n{\n")
   foreach(module ${CAPSULE_EXCLUDABLE_MODULES})
      # the constant's name: k + the module's name with its first letter upper-case (kSeq, kStorage)
      string(SUBSTRING ${module} 0 1 first)
      string(SUBSTRING ${module} 1 -1 rest)
      string(TOUPPER ${first} first)
      if(module IN_LIST modules)
         set(value true)
      else()
         set(value false)
      endif()
      string(APPEND text "inline constexpr bool k${first}${rest} = ${value};   ///< module ${module} is left out\n")
   endforeach()
   string(APPEND text "} // namespace capsule::exclude\n")
   file(CONFIGURE OUTPUT ${dir}/capsule/exclude_config.h CONTENT "${text}")
endfunction()

# Leaves the excluded modules' sources (src/<module>/) out of the engine library. Deferred to the end of the
# engine's folder, after every part has added its sources.
function(capsule_exclude_apply)
   if(NOT CAPSULE_EXCLUDED_MODULES)
      return()
   endif()
   get_target_property(sources capsule_engine SOURCES)
   set(kept)
   set(dropped 0)
   foreach(source ${sources})
      get_filename_component(full ${source} ABSOLUTE BASE_DIR ${CAPSULE_ROOT})
      set(out FALSE)
      foreach(module ${CAPSULE_EXCLUDED_MODULES})
         string(FIND "${full}" "${CAPSULE_ROOT}/src/${module}/" at)
         if(at EQUAL 0)
            set(out TRUE)
         endif()
      endforeach()
      if(out)
         math(EXPR dropped "${dropped} + 1")
      else()
         list(APPEND kept ${source})
      endif()
   endforeach()
   # the library's default script dispatch (every module op) without the manifest's script ops, whose handlers reach
   # the excluded modules (a game's own table, from its scripts' usage, takes its place at link as before)
   set(dispatch ${CMAKE_CURRENT_BINARY_DIR}/exclude_include/script_dispatch_excluded.cpp)
   add_custom_command(
      OUTPUT  ${dispatch}
      COMMAND Python3::Interpreter ${CAPSULE_ROOT}/tools/script_vm.py dispatch --exclude ${CAPSULE_EXCLUDE}
            --out ${dispatch}
      DEPENDS ${CAPSULE_ROOT}/tools/script_vm.py ${CAPSULE_ROOT}/tools/vm_ext.py
            ${CAPSULE_ROOT}/src/script/script_vm.json ${CAPSULE_EXCLUDE}
      COMMENT "Writing the engine's script dispatch without the excluded ops"
      VERBATIM)
   list(REMOVE_ITEM kept src/script/script_dispatch_all.cpp)
   list(APPEND kept ${dispatch})
   set_source_files_properties(${dispatch} PROPERTIES INCLUDE_DIRECTORIES ${CAPSULE_ROOT}/src/script)
   set_property(TARGET capsule_engine PROPERTY SOURCES ${kept})
   message(STATUS "Engine: ${CAPSULE_EXCLUDE} leaves out ${CAPSULE_EXCLUDED_MODULES} (${dropped} sources)")
endfunction()

set(CAPSULE_EXCLUDED_MODULES)
if(CAPSULE_EXCLUDE)
   capsule_exclude_read(${CAPSULE_EXCLUDE} CAPSULE_EXCLUDED_MODULES)
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${CAPSULE_EXCLUDE})
endif()
# for capsule_game(), which a parent folder calls (this folder's variables are not visible there)
set_property(GLOBAL PROPERTY CAPSULE_EXCLUDED_MODULES "${CAPSULE_EXCLUDED_MODULES}")
capsule_exclude_header(${CMAKE_CURRENT_BINARY_DIR}/exclude_include "${CAPSULE_EXCLUDED_MODULES}")
target_include_directories(capsule_options INTERFACE ${CMAKE_CURRENT_BINARY_DIR}/exclude_include)
cmake_language(DEFER CALL capsule_exclude_apply)
