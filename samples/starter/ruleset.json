 "pipelines": {
  "damage": [
   {
    "let": "attack",
    "expr": "stage_scale(offense_stage_id, offense_raw, offense_stage)",
    "range": [
     1,
     "STAGED_CAP"
    ]
   },
   {
    "let": "defense",
    "expr": "if(crit, defense_raw, stage_scale(defense_stage_id, defense_raw, defense_stage))",
    "range": [
     1,
     "STAGED_CAP"
    ]
   },
   {
    "point": "offense",
    "on": "attack"
   },
   {
    "let": "power",
    "expr": "move_power"
   },
   {
    "point": "power",
    "on": "power"
   },
   {
    "let": "d",
    "expr": "damage_base(level, power, attack, defense)",
    "range": [
     0,
     65535
    ]
   },
   {
    "let": "d",
    "expr": "if(crit, mulq8(d, CRIT), d)",
    "range": [
     0,
     65535
    ]
   },
   {
    "let": "d",
    "expr": "if(same_type, mulq8(d, SAME_TYPE), d)",
    "range": [
     0,
     65535
    ]
   },
   {
    "let": "d",
    "expr": "type_scale(d)",
    "range": [
     0,
     65535
    ]
   },
   {
    "let": "d",
    "expr": "if(spread, mulq8(d, SPREAD), d)",
    "range": [
     0,
     65535
    ]
   },
   {
    "point": "weather",
    "on": "d"
   },
   {
    "roll": "r",
    "span": "ROLL_SPAN"
   },
   {
    "let": "d",
    "expr": "d * (ROLL_LOW + r) / ROLL_DEN",
    "range": [
     0,
     65535
    ]
   },
   {
    "point": "damage",
    "on": "d"
   },
   {
    "point": "guard",
    "on": "d"
   },
   {
    "let": "damage",
    "expr": "max(d, 1)",
    "range": [
     1,
     65535
    ]
   }
  ],
  "self_hit": [
   {
    "let": "attack",
    "expr": "stage_scale(offense_stage_id, offense_raw, offense_stage)",
    "range": [
     1,
     "STAGED_CAP"
    ]
   },
   {
    "let": "defense",
    "expr": "stage_scale(defense_stage_id, defense_raw, defense_stage)",
    "range": [
     1,
     "STAGED_CAP"
    ]
   },
   {
    "let": "d",
    "expr": "damage_base(level, move_power, attack, defense)"
   },
   {
    "roll": "r",
    "span": "ROLL_SPAN"
   },
   {
    "let": "d",
    "expr": "d * (ROLL_LOW + r) / ROLL_DEN"
   },
   {
    "let": "damage",
    "expr": "max(d, 1)",
    "range": [
     1,
     65535
    ]
   }
  ],
  "speed": [
   {
    "let": "speed",
    "expr": "stage_scale(speed_stage_id, speed_raw, speed_stage)",
    "range": [
     1,
     "STAGED_CAP"
    ]
   },
   {
    "point": "speed",
    "on": "speed"
   },
   {
    "let": "speed",
    "expr": "max(speed, 1)",
    "range": [
     1,
     "STAGED_CAP"
    ]
   }
  ],
  "accuracy": [
   {
    "let": "chance",
    "expr": "accuracy_staged(move_accuracy, accuracy_stage - evasion_stage)"
   },
   {
    "let": "out_of",
    "expr": "100"
   },
   {
    "roll": "r",
    "span": "if(chance > 0 && chance < out_of, out_of, 0)"
   },
   {
    "let": "hit",
    "expr": "chance >= out_of || r < chance"
   }
  ],
  "crit": [
   {
    "let": "stage",
    "expr": "crit_stage + move_crit_stage"
   },
   {
    "let": "chance",
    "expr": "crit_chance(stage)"
   },
   {
    "let": "out_of",
    "expr": "crit_out_of(stage)"
   },
   {
    "roll": "r",
    "span": "if(chance > 0 && chance < out_of, out_of, 0)"
   },
   {
    "let": "crit",
    "expr": "out_of != 0 && (chance >= out_of || r < chance)"
   }
  ],
  "effect_odds": [
   {
    "let": "chance",
    "expr": "effect_chance * (2 * user_stat + ODDS_SOFTEN) / (user_stat + target_stat + ODDS_SOFTEN)",
    "range": [
     0,
     65535
    ]
   },
   {
    "point": "odds",
    "on": "chance"
   },
   {
    "point": "resist",
    "on": "chance"
   },
   {
    "let": "out_of",
    "expr": "effect_out_of"
   },
   {
    "roll": "r",
    "span": "if(chance > 0 && chance < out_of, out_of, 0)"
   },
   {
    "let": "hit",
    "expr": "chance >= out_of || r < chance"
   }
  ],
  "recruit_odds": [
   {
    "let": "missing",
    "expr": "(target_max_hp - target_hp) * PCT / target_max_hp",
    "range": [
     0,
     "PCT"
    ]
   },
   {
    "let": "chance",
    "expr": "clamp(recruit_rate * (PCT + missing) / RECRUIT_RATE_DIV + bonus + status_bonus, 0, PCT)"
   },
   {
    "let": "out_of",
    "expr": "PCT"
   },
   {
    "let": "sure",
    "expr": "bonus >= RECRUIT_SURE"
   }
  ]
 }
}
