{
 "schema": "capsule.ruleset/2",
 "editor": {
  "notes": "The Starter sample's ruleset (E9; own numbers and formulas since C2, README \"Starter rules\"): stats grow linearly from a head start of base / 8 (HP) or base / 16 (core), reserve pools (MP, EP) without temperament; damage from Attack x power x (level + 5) against (Defence + 10); a crit pierces the target's defence stages; ep_regen returns 1 plus a sixteenth of the missing EP; the effect_odds pipeline scales odds by (2 x user Int + 60) / (user Int + target Int + 60), so equal Intelligence keeps the odds asked for. Staged stats (the attack, defense and speed lets, the offense point and the inputs damage_base and escape_odds take) run up to STAGED_CAP 1400 = the stat cap 700 x the top stage's x2, not the stat cap, so +3 / +4 stages still count at the top end (C4)."
 },
 "constants": {
  "HP_FLAT": 10,
  "HP_START": 8,
  "HP_DIV": 22,
  "CORE_FLAT": 3,
  "CORE_START": 16,
  "CORE_DIV": 36,
  "RESERVE_FLAT": 6,
  "RESERVE_DIV": 30,
  "PCT": 100,
  "DAMAGE_LEVEL_BIAS": 5,
  "DEFENCE_PAD": 10,
  "DAMAGE_DIV": 50,
  "DAMAGE_FLAT": 1,
  "CRIT": 416,
  "SAME_TYPE": 307,
  "SPREAD": 180,
  "ROLL_LOW": 92,
  "ROLL_SPAN": 17,
  "ROLL_DEN": 100,
  "EXP_DIV": 10,
  "EXP_LEVEL_BIAS": 10,
  "EXP_RANK_BASE": 4,
  "REWARD_FLAT": 8,
  "REWARD_DIV": 2,
  "ESCAPE_BASE": 96,
  "ESCAPE_SHARE": 128,
  "ESCAPE_TRY": 48,
  "REGEN_FLAT": 1,
  "REGEN_SHARE": 16,
  "ODDS_SOFTEN": 60,
  "STAGED_CAP": 1400,
  "RECRUIT_RATE_DIV": 400,
  "RECRUIT_SURE": 100,
  "TRAIN_SHARE": 8,
  "TRAIN_PER_YIELD": 2
 },
