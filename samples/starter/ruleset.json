 },
 "formulas": {
  "damage_base": {
   "args": [
    "level",
    "power",
    "attack",
    "defense"
   ],
   "expr": "attack * power * (level + DAMAGE_LEVEL_BIAS) / ((defense + DEFENCE_PAD) * DAMAGE_DIV) + DAMAGE_FLAT",
   "range": [
    1,
    65535
   ]
  },
  "exp_gain": {
   "expr": "max(1, yield * level / EXP_DIV * (level + EXP_LEVEL_BIAS) / (victor_level + EXP_LEVEL_BIAS) * (EXP_RANK_BASE + foe_rank) / EXP_RANK_BASE / participants)",
   "range": [
    1,
    16777215
   ]
  },
  "reward": {
   "expr": "reward_base * (level + REWARD_FLAT) / REWARD_DIV",
   "range": [
    0,
    1900515
   ]
  },
  "escape_odds": {
   "expr": "ESCAPE_BASE + ESCAPE_SHARE * speed / (speed + foe_speed) + ESCAPE_TRY * attempts",
   "range": [
    0,
    65535
   ]
  },
  "ep_regen": {
   "args": [
    "pool_value",
    "pool_max"
   ],
   "expr": "REGEN_FLAT + max(0, pool_max - pool_value) / REGEN_SHARE",
   "range": [
    0,
    700
   ]
  },
  "train_gain": {
   "args": [
    "train_yield",
    "train_value",
    "train_total",
    "train_level"
   ],
   "expr": "train_yield * TRAIN_PER_YIELD",
   "range": [
    0,
    6
   ]
  }
 },
 "stat_formulas": {
  "vital": {
   "expr": "HP_FLAT + base / HP_START + level * (base + gene) / HP_DIV + training / TRAIN_SHARE",
   "range": [
    1,
    700
   ]
  },
  "reserve": {
   "expr": "RESERVE_FLAT + level * (base + gene) / RESERVE_DIV + training / TRAIN_SHARE",
   "range": [
    1,
    700
   ]
  },
  "core": {
   "expr": "(CORE_FLAT + base / CORE_START + level * (base + gene) / CORE_DIV) * trait_pct / PCT + training / TRAIN_SHARE",
   "range": [
    1,
    700
   ]
  }
 },
