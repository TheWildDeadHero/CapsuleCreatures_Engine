# Desktop (CMake) builds
/build/

# GBA builds
/platform/gba/build/
/platform/gba/*.gba
/platform/gba/*.elf
/platform/gba/*.map

# Emulator output
*.sav
*.ss[0-9]

# Editor state
/.cache/

# Imported third-party content (importer output; never committed here, D-3 / D-29)
assets-imported/

# Other build folders, environments and caches (D-37: never committed)
/build-*/
/build_*/
/cmake-build-*/
.venv/
__pycache__/
*.pyc
.local/
*.sqlite

# Local scratch work that must never be committed (developer rule): any name containing DO_NOT_ADD.
*DO_NOT_ADD*
